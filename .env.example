OPENAI_API_KEY=""
# OPENAI_BASE_URL=https://api.openai.com/v1

# Ten observations at 30-second intervals produce one roughly five-minute episode.
CONTINUE_CAPTURE_BATCH_SIZE=10
CONTINUE_CAPTURE_INTERVAL_SECONDS=30
# Lower-resolution JPEGs keep multimodal requests fast and inexpensive.
CONTINUE_CAPTURE_MAX_WIDTH=1440
CONTINUE_CAPTURE_JPEG_QUALITY=0.55
# "auto" preserves enough browser text to identify people, companies, and job titles.
# Set to "low" to minimize vision cost at the expense of detail recognition.
CONTINUE_VISION_DETAIL=auto

# Native macOS integrations. The database path defaults to the repository's
# data/memory.sqlite when the preview is launched from this workspace.
CONTINUE_MEMORY_DATABASE_PATH=""
# Optional voice used by the direct summary reader. Defaults to ElevenLabs' George voice.
CONTINUE_ELEVENLABS_VOICE_ID=""
# Keep this key in the headless local service. It is never returned to the
# native app or bundled into the macOS application.
ELEVENLABS_API_KEY=""
# Native app speech endpoint. Keep the web server running when using native voice.
CONTINUE_ELEVENLABS_SPEECH_URL="http://localhost:3000/api/voice/speak"
CONTINUE_CHAT_URL="http://localhost:3000/api/chat"
CONTINUE_BACKEND_URL="http://localhost:3000"
