{
  "name": "continue-ai",
  "private": true,
  "version": "0.0.1",
  "packageManager": "pnpm@9.12.3",
  "scripts": {
    "dev": "corepack pnpm --filter @continue/web dev",
    "dev:web": "corepack pnpm --filter @continue/web dev",
    "dev:worker": "corepack pnpm --filter @continue/worker dev",
    "build": "pnpm -r build",
    "typecheck": "corepack pnpm -r typecheck",
    "verify:memory": "node --import tsx scripts/verify-memory.ts"
  },
  "devDependencies": {
    "@types/node": "^22.7.4",
    "tsx": "^4.19.2",
    "typescript": "^5.6.2"
  }
}
